# MongoDB connection string used by Prisma. The database name goes in the path.
# Prisma requires a replica set (needed for transactions):
#   - MongoDB Atlas (any tier, including free M0) works as-is:
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/soulmate_cafe?retryWrites=true&w=majority"
#   - Local mongod started as a single-node replica set (see README):
# DATABASE_URL="mongodb://localhost:27017/soulmate_cafe?replicaSet=rs0&directConnection=true"

# Session cookies are marked Secure (sent over HTTPS only) whenever NODE_ENV=production.
# Serve the app over HTTPS. Only if you run `npm start` on a trusted cafe LAN over plain
# http://<ip>:3000 must you set this to false, or sign-in will not stick.
# COOKIE_SECURE=false

# Address printed in the table QR code (Menu → Table QR). Leave unset to use the address the
# QR page is opened on (localhost is swapped for this computer's Wi-Fi IP automatically).
# PUBLIC_BASE_URL="https://menu.soulmatehouse.in"
